{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "development",
        "PACKR_ANDROID_ALLOW_CLEARTEXT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "PACKR_ANDROID_ALLOW_CLEARTEXT": "0"
      }
    },
    "production": {
      "autoIncrement": "versionCode",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NODE_ENV": "production",
        "PACKR_ANDROID_ALLOW_CLEARTEXT": "0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
