PACKR_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/packr?retryWrites=true&w=majority
DB_NAME=packr
MONGO_APP_NAME=packr-api
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Firebase Admin
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_AUTH_STRICT=1
ALLOW_LEGACY_AUTH=0

# Use one Firebase credential source:
FIREBASE_CREDENTIALS_PATH=./service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", "...":"..."}
# FIREBASE_CREDENTIALS_BASE64=<base64-service-account-json>

# API
CORS_ORIGINS=https://app.example.com
PUBLIC_UPLOAD_BASE_URL=https://api.example.com/uploads
FEATURE_PRO_ENABLED=0
